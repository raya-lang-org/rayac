AST_MODULE_DECL (main)
  AST_VAR_DECL (x)
    Type: TYPE_OPTIONAL
      Type: TYPE_NAMED (u32)
    Init:
      AST_INT_LITERAL (42)
  AST_CONST_DECL (y)
    Type: TYPE_NAMED (f64)
    Init:
      AST_FLOAT_LITERAL (3.140000)
  AST_IF
    Cond:
      AST_BINARY (TOK_EQUAL_EQUAL)
        Left: AST_IDENTIFIER (x)
        Right: AST_INT_LITERAL (42)
    Then:
      AST_BLOCK
        AST_EXPR_STMT
          AST_ASSIGN (TOK_EQUAL)
            Target: AST_IDENTIFIER (y)
            Value: AST_FLOAT_LITERAL (0.000000)
    Else:
      AST_BLOCK
        AST_RETURN (null)
