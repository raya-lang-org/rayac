E. TYPED BUILDER API — COMPLETE STRUCT DEFINITIONS

These structs define the COMPLETE stable surface of the comptime reflection API.
They are NOT the full compiler AST. They are a capability-based subset that
insulates user comptime code from compiler internals.

E.1 ENUMERATIONS

pub enum DeclKind {
    function,
    struct,
    union,
    enum,
    traits,
    extend,       // [ADDED v0.7.6] inherent and trait extend blocks
    type_alias,
}

pub enum Visibility {
    private,
    pub,
}

pub enum TypeKind {
    void,
    bool,
    int,           // i8, i16, i32, i64, i128, isize
    uint,          // u8, u16, u32, u64, u128, usize
    float,         // f32, f64
    pointer,       // &T, &const T, *T, *const T
    slice,         // []T, []const T
    array,         // [N]T
    struct,        // named struct type
    enum,          // named enum type
    union,         // named union type
    optional,      // ?T
    error_union,   // !T
    function,      // fn(...) -> T
    vector,        // std.builtin.vector(N, T)
    opaque,        // std.builtin.opaque()
