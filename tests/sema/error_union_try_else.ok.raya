struct MyError { code: i64 }

/** TODO::notes if MyError!i32 for cast like this ? MyError!i32 as i32 its valid or not ? **/
fn may_fail(x: i64) -> MyError!i64 {  
    if (x < 0) {
        return MyError{ code: 1 };
    }
    return x * 2;
}

fn main() -> i32 {
    const a = try may_fail(5) else |e| {
        return 0;
    };
    return a;
}
