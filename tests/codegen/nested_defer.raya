struct Box { val: i64 }
extend Box {
    pub fn set(self: &Box, v: i64) -> void {
        self.val = v;
    }
}

// expect_exit: 11
fn main() -> i64 {
    var a = Box{ val: 0 };
    var b = Box{ val: 0 };
    {
        defer a.set(1);
        {
            defer b.set(10);
            a.val = 0;
            b.val = 0;
        }
    }
    return a.val + b.val;
}
