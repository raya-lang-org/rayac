A. LEXICAL (A.4)
  Keywords (30): module import fn pub const var comptime defer errdefer test
    return if else while for try break continue match struct union enum traits
    extend type unsafe noreturn as with undefined
  Primitives (NOT keywords): i8-128 isize u8-128 usize f32 f64 bool void
  Bitfields (#[packed] only): u1-u7
  Literals: true false null undefined
  ID: [a-zA-Z_][a-zA-Z0-9_]*   __ reserved for compiler
  Int: dec | 0xhex | 0ooctal | 0bbinary
  Float: [0-9]+.[0-9]+([eE][+-]?[0-9]+)? | [0-9]+[eE][+-]?[0-9]+
  String: "..."  -> []const u8    Char: '...' -> u8
  Escapes: \n \t \" \' \\ \0
  Comment: // line  /* nestable block */ max depth 16
  BOM stripped. \r alone = error. \r\n = valid line ending.

B. EBNF (compact)
  compilation_unit ::= module_decl? import_stmt* top_level_decl*
  module_decl      ::= "module" ident ";"
  import_stmt      ::= "import" ident ("." ident)* ("as" ident)? ";"
  top_level_decl   ::= ("pub")? (fn_decl | struct_decl | enum_decl | union_decl
                        | trait_decl | extend_decl | type_alias
                        | "const" ident ":" type_expr "=" expr ";"
                        | "var"   ident ":" type_expr "=" expr ";"
                        | test_decl)

  fn_decl          ::= attr* "comptime"? "fn" ident generic_params?
                        "(" param_list? ")" return_type? (block | ";")
  generic_params   ::= "(" ident ":" "type" ("with" trait_list)? ")"
  param_list       ::= param ("," param)*
  param            ::= ident ":" type_expr ("=" expr)? | self_param
  self_param       ::= ("&" "const"?)? "self" | "self" ":" type_expr
  return_type      ::= "->" type_expr
  block            ::= "{" stmt* expr? "}"       // trailing expr = block value

  stmt ::= "const" ident (":" type_expr)? "=" expr ";"
         | "var"   ident (":" type_expr)? "=" expr ";"
         | expr ("=" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^=" | "<<=" | ">>=") expr ";"
         | "return" expr? ";"
         | "if" expr block ("else" (block | if_stmt))?
         | "while" expr block
         | "for" ident ":" type_expr "in" expr block
         | "defer" expr ";"
         | "errdefer" block
         | "break" ";" | "continue" ";"
         | "match" expr "{" match_arm* "}"
         | block

  match_arm        ::= pattern "=>" expr ","
  pattern          ::= "_" | literal | ident | "." ident ("(" pattern ")")?
                      | ".{" field_pattern* "}"

  expr (precedence high→low):
    primary ::= literal | ident | "null" | "true" | "false" | "undefined"
              | array_literal | struct_literal | "(" expr ")"
    postfix ::= primary ("." ident | "." ident "(" arg_list? ")"
                        | "(" arg_list? ")" | "[" expr "]"
                        | "[" expr ".." expr "]")*
    unary   ::= "&" expr | "&" "const" expr | "*" expr | "-" expr
              | "!" expr | "~" expr
    cast    ::= unary ("as" type_expr)*
    mul     ::= cast (("*"|"/"|"%") cast)*
    add     ::= mul  (("+"|"-") mul)*
    shift   ::= add  (("<<"|">>") add)*
    bitand  ::= shift ("&" shift)*
    bitxor  ::= bitand ("^" bitand)*
    bitor   ::= bitxor ("|" bitxor)*
    cmp     ::= bitor (("=="|"!="|"<"|">"|"<="|">=") bitor)*
    logand  ::= cmp ("&&" cmp)*
    logor   ::= logand ("||" logand)*
    try     ::= "try" logor | logor
    capture ::= try ("else" "|" ident "|" block)?
    unsafe  ::= "unsafe" block | capture

  type_expr ::= primary_type ("!" | "?")?
  primary_type ::= ident ("(" type_arg_list ")")?
               | "fn" "(" type_list? ")" return_type?
               | "type" | primitive_type
               | "&" "const"? type_expr
               | "[]" "const"? type_expr
               | "*" "const"? type_expr
               | "[" expr "]" type_expr

  primitive_type ::= void | bool | i8|i16|i32|i64|i128|isize
                   | u8|u16|u32|u64|u128|usize | f32|f64 | noreturn

  array_literal    ::= "[" "]" type_expr "{" arg_list? "}"
                     | "[" expr "]" type_expr "{" arg_list? "}"
                     | "[" expr "]" type_expr "{" expr "," "}"
  struct_literal   ::= primary_type "{" (ident ":" expr ("," ident ":" expr)*)? "}"

  struct_decl      ::= attr* "struct" ident generic_params? "{" field_decl* "}"
  field_decl       ::= attr* "pub"? ident ":" type_expr ("=" expr)? ","
  enum_decl        ::= attr* "enum" ident "{" variant_decl* "}"
  variant_decl     ::= ident ("(" type_expr ")")? ("=" expr)? ","
  union_decl       ::= attr* "union" ident generic_params? "{" field_decl* "}"
  trait_decl       ::= "traits" ident "{" trait_method* "}"
  trait_method     ::= "pub"? "fn" ident "(" param_list? ")" return_type? ";"
  extend_decl      ::= "extend" (ident generic_params? | ident generic_params? "with" trait_list)
                        "{" fn_decl* "}"
  type_alias       ::= "type" ident "=" type_expr ";"
  test_decl        ::= "test" string_literal block
  attr             ::= "#" "[" ident ("(" expr ("," expr)* ")")? "]"

C. KEY SEMANTICS
  C.1  No parens around while/if conditions: while true {}  NOT while (true) {}
  C.2  self shorthand: &const self => self: &const Self; &self => self: &Self
  C.3  Trait object-safe iff: no comptime/generic params, receiver is &T/&const T,
       does not return T by value.
  C.4  !T layout: { tag: u32, payload: T }. tag 0 = success. Non-zero = module_id<<16|error_code.
  C.5  Cast (as): int<->int, int<->float, ptr<->ptr (unsafe), ptr<->int (unsafe), enum<->int.
  C.6  defer = BLOCK-scoped (LIFO). errdefer = FUNCTION-scoped, error path only (LIFO).
  C.7  unsafe required for: *ptr dereference, ptr arithmetic, type punning,
       inline asm, extern C calls without wrappers, *void->typed ptr.
  C.8  Generic constraint: T: type with Trait1, Trait2
  C.9  undefined = uninitialized. Cannot read. Cannot use in comptime.
  C.12 Self resolves to enclosing type in struct/union/enum/trait/extend blocks.
  C.15 Trailing expr in block = block value. No semicolon. Absent = void.
  C.18 Generics: Vec3(f32). No <>.
  C.20 Bitfields u1-u7 only in #[packed]. Byte-aligned fields keep alignment.
  C.21 Dereference: *ptr only. No ptr.* sugar. Auto-deref on &T/&const T only.
  C.22 #[extern("C")] fn may omit body (";"). Trait methods also ";" body.

D. TYPE SYSTEM
  &T        : non-null mutable ref. No arithmetic. Rebindable. Aliasing allowed.
  &const T  : non-null immutable ref. Multiple allowed.
  ?&T       : optional ref. Null-pointer optimized (zero addr = null).
  []T       : fat pointer { ptr: *T, len: usize }. Bounds-checked.
  []const T : immutable slice.
  *T        : raw pointer. Arithmetic allowed. Deref requires unsafe.
  *const T  : immutable raw pointer.
  [N]T      : fixed array. Coerces to []T and []const T.
  ?T        : optional. T or null.
  !T        : error union. Success(T) or error(tag).
  *void     : FFI only. Coerces to/from any *T in unsafe.

  Coercion: [N]T→[]T, [N]T→[]const T, &T→&const T, &T→*T (unsafe),
            T→!T (implicit on return), !T→T via try or else|err|.

